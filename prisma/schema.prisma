generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id             String   @id @default(uuid())
  numero_cliente String   @unique
  nome           String
  uf             String
  municipio      String
  cep            String
  faturas        Fatura[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([numero_cliente])
}

model Fatura {
  id String @id @default(uuid())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  instalacao      String
  mes_referencia  String
  data_vencimento DateTime

  // Energia elétrica
  energia_eletrica_quantidade Decimal @db.Decimal(12, 3)
  energia_eletrica_valor      Decimal @db.Decimal(12, 2)

  // Energia SCEE sem ICMS
  energia_sceee_icms_quantidade Decimal @db.Decimal(12, 3)
  energia_sceee_icms_valor      Decimal @db.Decimal(12, 2)

  // Energia compensada GD
  energia_compensada_gd_quantidade Decimal @db.Decimal(12, 3)
  energia_compensada_gd_valor      Decimal @db.Decimal(12, 2)

  // Contribuição pública
  contrib_ilum_publica_valor Decimal @db.Decimal(12, 2)

  // Campos calculados
  consumo_energia_eletrica_kwh Decimal @db.Decimal(12, 3) // energia_eletrica + energia_scee
  energia_compensada_kwh       Decimal @db.Decimal(12, 3) // energia_compensada_gd (mesmo valor)
  valor_total_sem_gd           Decimal @db.Decimal(12, 2) // energia_eletrica + energia_scee + contrib_ilum
  economia_gd                  Decimal @db.Decimal(12, 2) // energia_compensada_gd valor (geralmente negativo)

  url_download_fatura String
  resposta_json_llm   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clienteId])
  @@index([mes_referencia])
  @@index([clienteId, mes_referencia])
}
